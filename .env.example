# Local credentials. Copy to .env.local and fill in — never commit .env.local.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. For CI use repository secrets instead:
#   gh secret set YOUTUBE_CLIENT_ID
#   gh secret set YOUTUBE_CLIENT_SECRET
#   gh secret set YOUTUBE_REFRESH_TOKEN

# Google Cloud → enable "YouTube Data API v3" → Credentials → OAuth client ID
# → Application type: Desktop app.
#
# `npm run yt:auth` mints YOUTUBE_REFRESH_TOKEN from these two and prints the
# exact `gh secret set` lines. It only requests the youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Minted once by `npm run yt:auth`. Does not expire.
YOUTUBE_REFRESH_TOKEN=

# Optional.
# YT_PRIVACY=unlisted
# YT_TITLE_TEMPLATE=AnyRouter — {id}

# Local GitHub Releases publishing. In CI the built-in GITHUB_TOKEN is used
# automatically and you do not need this.
# GH_TOKEN=
