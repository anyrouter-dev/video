# generated by `npm run gen` — rebuilt from release/generate.mjs
/index.html
/compositions/

# regenerated by `npm run fetch` on every run. release/baseline.json IS
# committed — it is the reference the next diff is taken against.
/release/release.json

# rendered output. The mp4s are NOT tracked — they are ~8 MB each and they live
# on the GitHub Release, which is the durable public copy. The covers ARE tracked:
# a changelog is read as a grid of images, so a release with no image does not read.
/renders/
/out/
/.cover-tmp/
/agent-log.json
fetch.log

# copied out of assets/providers-src/ at generate time
/assets/providers/

# provider marks are vendored and MUST be committed — the render needs them
# and the live site is not a dependable source for them.
!/assets/providers-src/

node_modules/
.DS_Store
*.log

# real credentials — OAuth client id/secret, the YouTube refresh token.
# NEVER commit this. `.env.example` is the committed template.
.env
.env.local
.env.*.local
