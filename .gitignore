# generated by `npm run gen` — rebuilt from release/generate.mjs
/index.html
/compositions/

# regenerated by `npm run fetch` on every run. release/baseline.json IS
# committed — it is the reference the next diff is taken against.
/release/release.json

# rendered output
/renders/
/out/
/agent-log.json
fetch.log

# copied out of assets/providers-src/ at generate time
/assets/providers/

# provider marks are vendored and MUST be committed — the render needs them
# and the live site is not a dependable source for them.
!/assets/providers-src/

node_modules/
.DS_Store
*.log
